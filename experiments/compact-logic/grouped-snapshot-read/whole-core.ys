read_verilog rtl/diff8_uart_tx.v rtl/diff8_uart_rx.v experiments/compact-transceiver/inputs/rtl/diff8_digital.v
prep -top diff8_digital -flatten
async2sync
opt_clean
rename diff8_digital gold
design -stash gold
read_verilog rtl/diff8_uart_tx.v rtl/diff8_uart_rx.v experiments/compact-logic/grouped-snapshot-read/diff8_digital.v
prep -top diff8_digital -flatten
async2sync
opt_clean
rename diff8_digital gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
equiv_make gold gate equiv
hierarchy -top equiv
equiv_simple
equiv_induct -seq 4
equiv_status -assert
